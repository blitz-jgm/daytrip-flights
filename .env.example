# Copy to .env and adjust. Searching needs no secrets (both sources are public web pages);
# only the optional notifications at the bottom do. .env is git-ignored: never commit it.

# Run one search immediately when the container starts (then every 3 hours).
RUN_ON_START=true

# Log verbosity: DEBUG, INFO, WARNING
LOG_LEVEL=INFO

# Timezone used for "today" in cron (config.yaml `timezone` controls the search dates).
TZ=Asia/Seoul

# ---- Optional notifications (see README "Notifications") ----------------------------------
# Telegram alert when a real deal appears: create a bot with @BotFather, send it a message,
# then read your chat id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Daily e-mail digest after the full scan. For Gmail use an app password
# (Google Account > Security > 2-Step Verification > App passwords), not your login password.
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_TO=        # defaults to SMTP_USER
# EMAIL_FROM=      # defaults to SMTP_USER
