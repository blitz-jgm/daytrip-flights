<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>Day-trip flights</title>
</head>
{#- E-mail clients strip <style> blocks and scripts: tables and inline styles only. -#}
<body style="margin:0;padding:0;background:#f4f4f2;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Apple SD Gothic Neo','Malgun Gothic',sans-serif;color:#1f1f1d;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f2;">
<tr><td align="center" style="padding:16px 8px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:12px;">
  <tr><td style="padding:20px 20px 4px;">
    <div style="font-size:20px;font-weight:700;">Day-trip flights</div>
    <div style="font-size:13px;color:#6b6b66;padding-top:4px;">Cheapest same-day round trips · direct · 1 adult · economy · {{ generated_kst }} ({{ timezone }})</div>
  </td></tr>
  {% for r in routes %}
  <tr><td style="padding:16px 20px 0;">
    <div style="font-size:16px;font-weight:700;">{{ r.origins|join('/') }} → {{ r.destination }}</div>
    <div style="font-size:13px;color:#6b6b66;padding-top:2px;">Out {{ r.out_window }} · back {{ r.back_window }} (local time)</div>
  </td></tr>
  <tr><td style="padding:12px 20px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f0f5ff;border-radius:10px;">
      <tr><td style="padding:14px 16px;">
        <div style="font-size:13px;color:#4a5875;">Cheapest now</div>
        <div style="font-size:28px;font-weight:700;line-height:1.2;">{{ r.top[0].total|krw }}</div>
        <div style="font-size:14px;padding-top:2px;">{{ r.top[0].date }} ({{ r.top[0].weekday }}) · {{ "round trip" if r.top[0].kind == "bundle" else "2 × one-way" }}</div>
        {% if r.cheapest %}
        <div style="font-size:13px;color:#4a5875;padding-top:8px;">Lowest seen {{ r.cheapest.low|krw }} · typical {{ r.cheapest.median|krw }} · {{ r.cheapest.runs|length }} runs</div>
        {% endif %}
        {% if r.weekdays %}
        <div style="font-size:13px;color:#4a5875;padding-top:4px;">Cheapest weekdays: {% for wd, v in r.weekdays %}{{ wd }} {{ v|krw }}{{ " · " if not loop.last }}{% endfor %}</div>
        {% endif %}
      </td></tr>
    </table>
  </td></tr>
  <tr><td style="padding:14px 20px 4px;font-size:15px;font-weight:700;">Top {{ r.top|length }} dates</td></tr>
  <tr><td style="padding:0 20px 8px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;border-collapse:collapse;">
      {% for d in r.top %}
      <tr>
        <td valign="top" style="padding:10px 8px 10px 0;border-top:1px solid #e6e6e1;white-space:nowrap;">
          <div style="font-weight:600;">{{ d.date[5:] }}</div>
          <div style="font-size:12px;color:#6b6b66;">{{ d.weekday }}</div>
        </td>
        <td valign="top" style="padding:10px 0;border-top:1px solid #e6e6e1;">
          <div style="font-weight:700;">{{ d.total|krw }} <span style="font-weight:400;font-size:12px;color:#6b6b66;">{{ "round trip" if d.kind == "bundle" else "2 × one-way" }}</span></div>
          {% for leg in d.legs %}
          <div style="font-size:12px;color:#3d3d39;">{{ leg.flight_no }} {{ leg.origin }} {{ leg.dep }} → {{ leg.destination }} {{ leg.arr }} · {{ leg.source }}</div>
          {% endfor %}
          {% if d.links %}
          <div style="font-size:12px;padding-top:2px;">{% for lk in d.links %}<a href="{{ lk.url }}" style="color:#2f5bd3;">{{ lk.label }}</a>{{ " · " if not loop.last }}{% endfor %}</div>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </table>
  </td></tr>
  {% endfor %}
  <tr><td style="padding:12px 20px 20px;font-size:12px;color:#6b6b66;border-top:1px solid #e6e6e1;">
    The full interactive report with charts is attached as <b>report.html</b>; open it in a browser.
    Prices are snapshots from Google Flights / Naver Flights and can change at any time; always confirm on the booking site.
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
